{
  "description": "Rejects any file modification whose content contains the current username ($USER)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/block-username.sh"
          }
        ]
      }
    ]
  }
}
